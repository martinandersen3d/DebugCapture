<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
	<Identity Id="DebugCapture.048f07bc-68f7-4bc7-88a0-5238a6fd4bf1" Version="1.0" Language="en-US" Publisher="Martin Andersen" />
    <DisplayName>Debug Capture</DisplayName>
	<Description xml:space="preserve">Automatic Visual Studio debug capture for breakpoints, step actions, and exceptions. Saves IDE screenshots with matching text snapshots containing file, line, Locals, Autos, and call stack data. Useful for time travel debugging, diagnostics, bug reports, and documenting debugger state.</Description>
	<MoreInfo>https://github.com/martinandersen3d/DebugCapture</MoreInfo>
	<GettingStartedGuide>GETTING-STARTED.txt</GettingStartedGuide>
	<Icon>icon_512.png</Icon>
	<Tags>debug capture, debugging, breakpoints, exceptions, screenshots, locals, autos, call stack, time travel debugging, Visual Studio, .NET debugging, diagnostic tools, debugger snapshots, developer workflow, bug reports</Tags>
  </Metadata>
	<Installation>
		<InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>
		<InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.0,)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>
		<InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0,)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>
		<InstallationTarget Id="Microsoft.VisualStudio.IntegratedShell" Version="[17.0,)">
			<ProductArchitecture>amd64</ProductArchitecture>
		</InstallationTarget>
	</Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.5,)" d:Source="Manual" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" DisplayName="Visual Studio core editor" Version="[17.14, )" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" d:Source="Project" d:ProjectName="%CurrentProject%" />
  </Assets>
</PackageManifest>